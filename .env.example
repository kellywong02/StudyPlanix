# Supabase project settings — from your Supabase dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser. Used only by the cron/notifications route.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — from resend.com dashboard: API Keys (set up in M6)
RESEND_API_KEY=

# Shared secret for the /api/cron/send-reminders route (any long random string you generate)
CRON_SECRET=

# OpenAI API key — used to generate the AI study plan. Get one at platform.openai.com
OPENAI_API_KEY=
